# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Runtime data — never commit SQLite files, logs, or trace artefacts
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm
data/**/*.jsonl
# Derived, not authored: `hermes schedule` and the JSON importer both write
# this per project. It is a function of the plan, so tracking it only ever
# produces conflicts against whatever each machine last regenerated.
data/projects/*/schedule.json
# Likewise: `hermes ics` regenerates this from schedule.json on demand.
data/projects/*/*.ics
src/hermes_assistant/data/*.db
src/hermes_assistant/data/*.db-wal
src/hermes_assistant/data/*.db-shm
*.log

# Credentials
.env
.env.*
