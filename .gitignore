# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Runtime data — never commit SQLite files, logs, or trace artefacts
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm
data/**/*.jsonl
src/hermes_assistant/data/*.db
src/hermes_assistant/data/*.db-wal
src/hermes_assistant/data/*.db-shm
*.log

# Credentials
.env
.env.*
