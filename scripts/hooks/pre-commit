#!/usr/bin/env bash
# HERMES-Guardrail pre-commit hook — blocks confidential/runtime files.
# Activate with: git config core.hooksPath scripts/hooks
set -euo pipefail

# Only look at *added* or *modified* files — deletions of runtime files are safe
# and should not be blocked (they're the cleanup action we want to allow).
STAGED_ADDED=$(git diff --cached --name-only --diff-filter=ACMR)
STAGED_ALL=$(git diff --cached --name-only)

# --- Forbidden extensions (additions/modifications only) -------------------
FORBIDDEN_EXTS=(".db" ".db-wal" ".db-shm" ".log")
for ext in "${FORBIDDEN_EXTS[@]}"; do
  if echo "$STAGED_ADDED" | grep -qE "\\${ext}$"; then
    echo "HERMES-Guardrail: runtime/confidential file blocked: *${ext}"
    echo "  Remove from staging: git restore --staged <file>"
    exit 1
  fi
done

# --- Forbidden .env files ---------------------------------------------------
if echo "$STAGED_ALL" | grep -qE "(^|\/)\.env"; then
  echo "HERMES-Guardrail: credential file blocked: .env*"
  echo "  Remove from staging: git restore --staged <file>"
  exit 1
fi

# --- Forbidden runtime folders (should never appear as staged files) --------
FORBIDDEN_DIRS=("__pycache__/" "node_modules/" ".pytest_cache/" "build/" "dist/" ".egg-info/")
for dir in "${FORBIDDEN_DIRS[@]}"; do
  if echo "$STAGED_ALL" | grep -qF "$dir"; then
    echo "HERMES-Guardrail: runtime/build folder blocked: ${dir}"
    echo "  Add to .gitignore and run: git rm -r --cached <path>"
    exit 1
  fi
done

# --- PII terms dictionary check --------------------------------------------
# Test files legitimately reference credential/PII patterns to verify that
# detection works; exclude them from the keyword scan so that security audit
# tests can be committed without false positives.
if [ -f ".hermes/pii_terms.txt" ]; then
  DIFF_CONTENT=$(git diff --cached | grep '^+' | grep -v '^+++')
  # Strip additions that belong to test or documentation files — tests legitimately
  # reference PII patterns to verify detection; docs explain what the terms are.
  NON_TEST_DIFF=$(git diff --cached --name-only | grep -v '^tests/' | grep -v '^docs/' \
    | xargs -I{} git diff --cached -- {} 2>/dev/null | grep '^+' | grep -v '^+++' || true)
  while IFS= read -r term; do
    # Skip blank lines and comments
    [[ -z "$term" || "$term" == \#* ]] && continue
    if echo "$NON_TEST_DIFF" | grep -qi "$term"; then
      echo "HERMES-Guardrail: PII term detected in staged diff: \"${term}\""
      echo "  Review and remove sensitive content before committing."
      exit 1
    fi
  done < ".hermes/pii_terms.txt"
fi

exit 0
